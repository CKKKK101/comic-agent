# ============================================================
# comic-agent 环境配置(复制为 .env 后按需填写)
# 约定:厂商地址/模型/密钥全在此文件或设置页;代码不留不可覆盖的硬编码
# (个别地址有官方默认值兜底,如 DOUBAO_BASE_URL 的 cn-beijing 端点,均可覆盖)。
# ============================================================

# 环境: dev | prod(prod 不返回错误详情)
ENVIRONMENT=dev

# 数据库(默认本地 SQLite,零配置)
# DATABASE_URL=sqlite+aiosqlite:///./comic-agent.db

# ------------------------------------------------------------
# 文本生成(LLM)
# provider: fake(默认,零配置模板) | openai(OpenAI 兼容)
# ------------------------------------------------------------
TEXT_PROVIDER=fake
# TEXT_PROVIDER=openai 时必填:
# TEXT_BASE_URL=https://api.deepseek.com/v1
# TEXT_API_KEY=sk-xxxxxxxx
# TEXT_MODEL=deepseek-v4-flash

# ------------------------------------------------------------
# 图像生成(漫剧角色图/分镜图)
# provider: fake(默认) | siliconflow(SiliconFlow 图像接口,OpenAI 兼容外壳)
# ------------------------------------------------------------
IMAGE_PROVIDER=fake
# IMAGE_PROVIDER=siliconflow 时必填:
# IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_API_KEY=sk-xxxxxxxx
# IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
# IMAGE_SIZE=1024x576
#   Z-Image-Turbo 推荐分辨率:512x512 / 768x1024 / 1024x576 / 576x1024
#   漫剧 16:9 画幅建议 1024x576(按模型推荐值填写,不同模型不同)
# IMAGE_NEGATIVE_PROMPT=文字水印,模糊,低质量
# IMAGE_SEED=42            # 不填则随机;注意:URL 产物 1 小时内过期,本服务会自动下载落盘

# ------------------------------------------------------------
# 视频生成(漫剧成片;火山方舟 doubao-seedance,异步任务接口)
# provider: fake(默认) | ark
# ------------------------------------------------------------
VIDEO_PROVIDER=fake
# VIDEO_PROVIDER=ark 时必填:
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   # 可选:API 端点,默认 cn-beijing;换区域/企业网关时覆盖(与 IMAGE_BASE_URL 同权)
# DOUBAO_API_KEY=xxxxxxxx            # 火山方舟 ARK_API_KEY
# DOUBAO_VIDEO_MODEL=doubao-seedance-1-5-pro-251215
# VIDEO_DURATION=5                   # 单镜时长(5 或 10 秒)
# VIDEO_RATIO=16:9                   # 16:9 | 9:16 | 1:1 | adaptive
# VIDEO_MAX_SHOTS=3                  # 真实生成镜头数上限(0=全部;省钱演示建议 2-3)
# PUBLIC_BASE_URL=http://localhost:18766
#   # 可选:把 /static 图以 URL 传给视频服务(否则自动内联 data URL,限 8MB)

# ------------------------------------------------------------
# 台词配音(可选;成片合成时把分镜台词逐句合成语音铺进音轨)
# 复用图像服务的 SiliconFlow 凭据(IMAGE_BASE_URL/IMAGE_API_KEY),无需新密钥
# ------------------------------------------------------------
# TTS_ENABLED=1
# TTS_MODEL=fnlp/MOSS-TTSD-v0.5   # 或 CosyVoice2-0.5B
# TTS_VOICE=anna                  # 必填:预置音色名(女 anna/claire/bella;男 alex/benjamin/charles)

# ------------------------------------------------------------
# 质量闭环
# ------------------------------------------------------------
# CRITIQUE_FORCE_FAIL=1              # 调试:强制 critic 打低分,演示"批评→重做"
# CRITIQUE_ENABLED=1
# CRITIQUE_SCORE_THRESHOLD=6.0
# CRITIQUE_MAX_ROUNDS=2

# 推理模型思考开关:disabled(推荐,结构化 JSON 直接出)| enabled | auto(不传参数)
TEXT_THINKING=disabled

# 跨镜身份锚渲染模型(编辑类,留空=纯文字会跨镜漂移)
# IMAGE_CONSISTENCY_MODEL=Qwen/Qwen-Image-Edit-2509
